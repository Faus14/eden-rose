---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import About from '../components/About.astro';
import Historia from '../components/Historia.astro';
import WeddingDetails from '../components/WeddingDetails.astro';
import Rsvp from '../components/Rsvp.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Galeria from '../components/Galeria.astro';
import Showcase from '../components/Showcase.astro';
---

<Layout>
	<main>
		<Hero />
		<About />
		<Countdown />
		<Historia />
		<WeddingDetails />
		<Rsvp />
		<Tarjeta />
		<Galeria />
		<Showcase />
	</main>
	<footer class="bg-white px-6 py-10 text-center">
		<p class="text-[10px] tracking-[0.3em] uppercase opacity-60">
			Fotografía — Eden Rose Wedding Photography
		</p>
	</footer>
</Layout>
