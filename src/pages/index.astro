---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import About from '../components/About.astro';
import Historia from '../components/Historia.astro';
import WeddingDetails from '../components/WeddingDetails.astro';
import Rsvp from '../components/Rsvp.astro';
import Tarjeta from '../components/Tarjeta.astro';
---

<Layout>
	<main>
		<Hero />
		<About />
		<Countdown />
		<Historia />
		<WeddingDetails />
		<Tarjeta />
		<Rsvp />
	</main>
	<footer class="bg-porcelain px-6 py-12 text-center">
		<p class="font-display text-4xl leading-none font-light">Lucía & Fausto</p>
		<p class="mt-3 text-[10px] tracking-[0.32em] uppercase text-ink/55">7 de febrero · 19 hs</p>
	</footer>
</Layout>
