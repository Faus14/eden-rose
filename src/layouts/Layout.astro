---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Lucía & Fausto — 7 de febrero · Eden Rose',
	description
		= 'Lucía y Fausto se casan. Domingo 7 de febrero, 19 hs, Salón Catering Tita, Ramallo. Fotografía: Eden Rose Wedding Photography.',
} = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		{/*
			El diseño usa "The Seasons" (Fontspring, de pago) para el logo/títulos y
			Calibri para el cuerpo. Se reemplazan por alternativas gratuitas:
			- Cormorant Garamond Light ≈ The Seasons Light
			- Carlito ≈ Calibri (métricamente compatible)
		*/}
		<link
			href="https://fonts.googleapis.com/css2?family=Carlito:wght@400;700&family=Cormorant+Garamond:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />
	</head>
	<body class="bg-white font-body text-ink antialiased">
		<slot />
	</body>
</html>
