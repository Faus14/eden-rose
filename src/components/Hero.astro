---
import { Image } from 'astro:assets';
import couple from '../assets/couple.jpg';
import MonogramLF from './MonogramLF.astro';
---

<section
	id="inicio"
	transition:name="hero"
	class="relative flex min-h-[92svh] flex-col items-center overflow-hidden rounded-b-[2.5rem] bg-black text-white sm:rounded-b-[5rem] lg:min-h-0 lg:aspect-[1600/952] lg:rounded-b-[180px]"
	aria-label="Lucía y Fausto se casan"
>
	<Image
		src={couple}
		alt="Lucía y Fausto abrazados frente a frente bajo los árboles de un campo, en blanco y negro"
		class="absolute inset-0 h-full w-full object-cover object-[50%_52%]"
		widths={[640, 1024, 1600, 2142]}
		sizes="100vw"
		quality={80}
		loading="eager"
		fetchpriority="high"
	/>
	{/* Velo oscuro del diseño: rgba(0,0,0,0.15) */}
	<div class="absolute inset-0 bg-black/15" aria-hidden="true"></div>

	<div class="relative flex flex-col items-center px-6 pt-28 pb-16 sm:pt-36 lg:pt-[12.6%] lg:pb-0">
		{/* Fila superior: texto · monograma LF · texto */}
		<div class="flex items-center gap-4 sm:gap-14 lg:gap-[4.5rem]">
			<p
				class="text-right text-[10px] leading-relaxed tracking-[0.22em] [text-shadow:0_1px_10px_rgba(0,0,0,0.45)] sm:text-sm sm:tracking-[0.3em] lg:text-[17px]"
			>
				¡NOS<br />CASAMOS!
			</p>
			<div
				class="h-[104px] w-[70px] shrink-0 sm:h-[150px] sm:w-[100px] lg:h-[199px] lg:w-[134px]"
				role="img"
				aria-label="Monograma con las iniciales L y F dentro de un óvalo"
				transition:name="monograma"
			>
				<MonogramLF class="h-full w-full" />
			</div>
			<p
				class="text-left text-[10px] leading-relaxed tracking-[0.22em] [text-shadow:0_1px_10px_rgba(0,0,0,0.45)] sm:text-sm sm:tracking-[0.3em] lg:text-[17px]"
			>
				SALÓN<br />CATERING TITA
			</p>
		</div>

		<h1
			class="mt-10 font-display text-[clamp(1.6rem,8.2vw,8.6rem)] leading-none font-light whitespace-nowrap lg:mt-14"
		>
			LUCÍA <span aria-hidden="true">&</span><span class="sr-only">y</span> FAUSTO
		</h1>

		<p
			class="mt-8 flex items-center gap-3 text-[9px] tracking-[0.22em] [text-shadow:0_1px_10px_rgba(0,0,0,0.45)] sm:gap-8 sm:text-sm sm:tracking-[0.3em] lg:mt-16 lg:gap-10 lg:text-[19px]"
		>
			<span>DOMINGO 7 DE FEBRERO</span>
			<span class="h-px w-8 bg-white sm:w-14 lg:w-[66px]" aria-hidden="true"></span>
			<span>19 HS</span>
		</p>
	</div>
</section>
