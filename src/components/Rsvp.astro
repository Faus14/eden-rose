---
const numeroWhatsApp = '5493364357444';
const mensaje = encodeURIComponent(
	'¡Hola! Quiero confirmar mi asistencia al casamiento de Lucía y Fausto (7 de febrero).',
);
const linkWhatsApp = `https://wa.me/${numeroWhatsApp}?text=${mensaje}`;
---

<section id="confirmar" class="bg-black px-6 py-24 text-white lg:py-[132px]">
	<div class="mx-auto max-w-[731px] text-center">
		<p class="text-[11px] tracking-[0.3em] uppercase text-white/65">Confirmación</p>
		<h2 class="mt-5 font-display text-[clamp(2.4rem,7vw,4.5rem)] leading-none font-light">
			Confirmá tu asistencia
		</h2>
		<p class="mt-8 text-[19px] leading-normal text-white/85 sm:text-[21px]">
			Tu presencia es el mejor regalo para nosotros. Escribinos por WhatsApp y confirmanos que nos
			acompañás.
		</p>
		<a
			href={linkWhatsApp}
			target="_blank"
			rel="noopener"
			class="mt-10 inline-block border border-white px-8 py-3 text-[11px] tracking-[0.3em] uppercase transition-colors hover:bg-white hover:text-black"
		>
			Confirmar por WhatsApp
		</a>
	</div>
</section>
