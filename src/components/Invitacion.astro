---
import Hero from './Hero.astro';
import Countdown from './Countdown.astro';
import About from './About.astro';
import Historia from './Historia.astro';
import WeddingDetails from './WeddingDetails.astro';
import Rsvp from './Rsvp.astro';
import Tarjeta from './Tarjeta.astro';

interface Props {
	/** Muestra la sección con el valor de la tarjeta y el alias de pago. */
	mostrarTarjeta?: boolean;
}

const { mostrarTarjeta = false } = Astro.props;
---

<main>
	<Hero />
	<About />
	<Countdown />
	<Historia />
	<WeddingDetails />
	{mostrarTarjeta && <Tarjeta />}
	<Rsvp />
</main>
<footer class="bg-porcelain px-6 py-12 text-center">
	<p class="font-display text-4xl leading-none font-light">Lucía & Fausto</p>
	<p class="mt-3 text-[10px] tracking-[0.32em] uppercase text-ink/55">7 de febrero · 19 hs</p>
</footer>
