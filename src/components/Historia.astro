---
import { Image } from 'astro:assets';
import miradas from '../assets/couple-4.jpg';

/*
	TODO: reemplazar los textos entre corchetes por la historia real
	(cómo se conocieron, la propuesta, fechas importantes).
*/
---

<section id="nuestra-historia" class="bg-white">
	<div class="grid md:grid-cols-2">
		<div class="aspect-[4/5] overflow-hidden md:aspect-auto">
			<Image
				src={miradas}
				alt="Lucía y Fausto abrazados mirándose a los ojos en el campo, en blanco y negro"
				class="h-full w-full object-cover grayscale"
				widths={[640, 1024, 1600]}
				sizes="(min-width: 768px) 50vw, 100vw"
				quality={80}
				loading="lazy"
			/>
		</div>
		<div class="flex items-center px-6 py-24 sm:px-12 lg:px-20 lg:py-[139px]">
			<div class="max-w-[520px]">
				<p class="text-[11px] tracking-[0.3em] uppercase opacity-70">Nuestra historia</p>
				<h2 class="mt-5 font-display text-[clamp(2.2rem,5vw,3.5rem)] leading-tight font-light">
					Todo empezó mucho antes de este día
				</h2>
				<p class="mt-8 text-[19px] leading-normal tracking-[-0.01em] sm:text-[21px]">
					[Cómo nos conocimos: contanos dónde y cuándo empezó todo, y lo completamos acá.]
				</p>
				<p class="mt-6 text-[19px] leading-normal tracking-[-0.01em] sm:text-[21px]">
					[La propuesta: el momento en que decidimos casarnos.]
				</p>
			</div>
		</div>
	</div>
</section>
