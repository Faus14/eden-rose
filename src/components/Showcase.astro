---
import { Image } from 'astro:assets';
import EmblemLF from './EmblemLF.astro';
import manos from '../assets/couple-2.jpg';
import abrazo from '../assets/couple-3.jpg';
---

<section aria-label="Lucía y Fausto — 7 de febrero">
	<div class="grid md:grid-cols-2">
		{/* Nombres sobre gris, arriba a la izquierda (patrón damero del diseño) */}
		<div class="flex aspect-[800/857] items-center justify-center bg-mist px-8">
			<div class="text-center">
				<p
					class="font-display text-[clamp(1.8rem,11.5vw,5.75rem)] leading-none font-light whitespace-nowrap md:text-[clamp(1.8rem,5.8vw,5.8rem)]"
				>
					LUCÍA <span aria-hidden="true">&</span><span class="sr-only">y</span> FAUSTO
				</p>
				<p
					class="mt-[10%] flex items-center justify-center gap-3 text-[9px] tracking-[0.28em] sm:gap-6 sm:text-[12px] md:text-[15px]"
				>
					<span>DOMINGO 7 DE FEBRERO</span>
					<span class="h-px w-8 bg-black sm:w-14 md:w-[66px]" aria-hidden="true"></span>
					<span>19 HS</span>
				</p>
			</div>
		</div>
		<div class="aspect-[800/857] overflow-hidden">
			<Image
				src={manos}
				alt="Lucía y Fausto tomados de las manos, con el anillo de compromiso a la vista"
				class="h-full w-full object-cover grayscale"
				widths={[640, 1024, 1600]}
				sizes="(min-width: 768px) 50vw, 100vw"
				quality={80}
				loading="lazy"
			/>
		</div>
		<div class="aspect-[800/857] overflow-hidden">
			<Image
				src={abrazo}
				alt="Lucía y Fausto abrazados en el campo, ella apoya la cabeza en su pecho"
				class="h-full w-full object-cover object-[50%_30%] grayscale"
				widths={[640, 1024, 1600]}
				sizes="(min-width: 768px) 50vw, 100vw"
				quality={80}
				loading="lazy"
			/>
		</div>
		{/* Emblema circular sobre gris, abajo a la derecha */}
		<div class="flex aspect-[800/857] items-center justify-center bg-mist">
			<EmblemLF class="h-auto w-[41%] text-black" />
		</div>
	</div>
</section>
