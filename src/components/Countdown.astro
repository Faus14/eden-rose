---
import { Image } from 'astro:assets';
import manos from '../assets/couple-2.jpg';

// Cuenta regresiva a la fecha del casamiento (hora de Argentina).
const fechaEvento = '2027-02-07T19:00:00-03:00';

// Link "Agendar fecha" (Google Calendar). 19 hs ART = 22:00 UTC; fin estimado 04 hs ART.
const linkCalendario =
	'https://calendar.google.com/calendar/render?action=TEMPLATE'
	+ '&text=' + encodeURIComponent('Casamiento de Lucía y Fausto')
	+ '&dates=20270207T220000Z/20270208T070000Z'
	+ '&location=' + encodeURIComponent('Salón Catering Tita, Ramallo, Buenos Aires (-33.494440, -59.991723)')
	+ '&details=' + encodeURIComponent('¡Nos casamos! Te esperamos para celebrar juntos.');
---

<section
	id="cuenta-regresiva"
	class="relative overflow-hidden bg-black text-white"
	aria-label="Cuenta regresiva para el casamiento"
>
	<Image
		src={manos}
		alt=""
		aria-hidden="true"
		class="absolute inset-0 h-full w-full object-cover object-center grayscale"
		widths={[640, 1024, 1600, 2000]}
		sizes="100vw"
		quality={75}
		loading="lazy"
	/>
	{/* Velo oscuro para que el texto blanco corte sobre la foto */}
	<div class="absolute inset-0 bg-black/70" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-[900px] px-6 py-28 text-center lg:py-[150px]">
		<p
			class="flex items-center justify-center gap-4 text-[10px] tracking-[0.3em] uppercase opacity-90 sm:gap-8 sm:text-[12px]"
		>
			<span class="h-px w-8 bg-white/60 sm:w-14" aria-hidden="true"></span>
			<span>Falta cada vez menos</span>
			<span class="h-px w-8 bg-white/60 sm:w-14" aria-hidden="true"></span>
		</p>
		<h2 class="mt-6 font-display text-[clamp(2.4rem,7vw,4.5rem)] leading-none font-light">
			Cuenta regresiva
		</h2>

		<div
			id="countdown"
			data-target={fechaEvento}
			role="timer"
			class="mt-14 grid grid-cols-2 gap-y-10 sm:grid-cols-4 sm:gap-y-0"
		>
			<div>
				<p data-unit="d" class="font-display text-6xl leading-none font-light sm:text-7xl">–</p>
				<p class="mt-3 text-[11px] tracking-[0.3em] uppercase opacity-80">Días</p>
			</div>
			<div class="sm:border-l sm:border-white/25">
				<p data-unit="h" class="font-display text-6xl leading-none font-light sm:text-7xl">–</p>
				<p class="mt-3 text-[11px] tracking-[0.3em] uppercase opacity-80">Horas</p>
			</div>
			<div class="sm:border-l sm:border-white/25">
				<p data-unit="m" class="font-display text-6xl leading-none font-light sm:text-7xl">–</p>
				<p class="mt-3 text-[11px] tracking-[0.3em] uppercase opacity-80">Minutos</p>
			</div>
			<div class="sm:border-l sm:border-white/25">
				<p data-unit="s" class="font-display text-6xl leading-none font-light sm:text-7xl">–</p>
				<p class="mt-3 text-[11px] tracking-[0.3em] uppercase opacity-80">Segundos</p>
			</div>
		</div>

		<a
			href={linkCalendario}
			target="_blank"
			rel="noopener"
			class="mt-14 inline-block border border-white px-8 py-3 text-[11px] tracking-[0.3em] uppercase transition-colors hover:bg-white hover:text-black"
		>
			Agendar fecha
		</a>
	</div>
</section>

<script>
	function iniciarCuentaRegresiva() {
		const raiz = document.getElementById('countdown');
		if (!raiz) return;
		const objetivo = new Date(raiz.dataset.target!).getTime();
		const celdas = {
			d: raiz.querySelector('[data-unit="d"]')!,
			h: raiz.querySelector('[data-unit="h"]')!,
			m: raiz.querySelector('[data-unit="m"]')!,
			s: raiz.querySelector('[data-unit="s"]')!,
		};
		const actualizar = () => {
			const resta = Math.max(0, objetivo - Date.now());
			const seg = Math.floor(resta / 1000);
			celdas.d.textContent = String(Math.floor(seg / 86400));
			celdas.h.textContent = String(Math.floor((seg % 86400) / 3600)).padStart(2, '0');
			celdas.m.textContent = String(Math.floor((seg % 3600) / 60)).padStart(2, '0');
			celdas.s.textContent = String(seg % 60).padStart(2, '0');
		};
		actualizar();
		setInterval(actualizar, 1000);
	}
	iniciarCuentaRegresiva();
	document.addEventListener('astro:page-load', iniciarCuentaRegresiva);
</script>
