---
---

<section id="evento" class="bg-white px-6 py-24 lg:py-[139px]">
	<div class="mx-auto max-w-[731px] text-center">
		<h2 class="font-display text-[clamp(2.6rem,8vw,5.5rem)] leading-none font-light">
			El gran día
		</h2>
		<p class="mt-8 text-[19px] sm:text-[21px]">Domingo 7 de febrero — 19 hs</p>
		<p
			class="mt-4 flex items-center justify-center gap-4 text-[11px] tracking-[0.3em] uppercase sm:gap-8 sm:text-sm"
		>
			<span class="h-px w-8 bg-black sm:w-14" aria-hidden="true"></span>
			<span>Salón Catering Tita</span>
			<span class="h-px w-8 bg-black sm:w-14" aria-hidden="true"></span>
		</p>

		<p class="mt-10 text-[11px] tracking-[0.3em] uppercase opacity-70">Dress code</p>
		<p class="mt-2 font-display text-[clamp(1.6rem,4vw,2.4rem)] leading-none font-light">
			Elegante
		</p>

		{/*
			TODO: reemplazar la URL del iframe por el embed exacto del salón
			(Google Maps → Compartir → Insertar un mapa) cuando esté la dirección.
		*/}
		<div
			class="mt-12 aspect-[4/3] overflow-hidden rounded-[2rem] border border-black/15 sm:aspect-[16/9] lg:rounded-[3rem]"
		>
			<iframe
				title="Mapa con la ubicación del evento: Salón Catering Tita"
				src="https://www.google.com/maps?q=Sal%C3%B3n%20Catering%20Tita&output=embed"
				class="h-full w-full border-0"
				loading="lazy"
				allowfullscreen
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
		</div>
		<a
			href="https://www.google.com/maps/search/?api=1&query=Sal%C3%B3n%20Catering%20Tita"
			target="_blank"
			rel="noopener"
			class="mt-8 inline-block border border-black px-8 py-3 text-[11px] tracking-[0.3em] uppercase transition-colors hover:bg-black hover:text-white"
		>
			Cómo llegar
		</a>
	</div>
</section>
