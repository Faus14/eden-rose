---
import { Image } from 'astro:assets';
import retrato from '../assets/couple.jpg';
---

<section id="evento" class="bg-porcelain px-6 py-24 lg:py-[132px]">
	<div class="mx-auto grid max-w-[1120px] gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-20">
		<div>
			<p class="text-[11px] tracking-[0.32em] uppercase text-blush">El gran día</p>
			<h2 class="mt-5 font-display text-[clamp(2.8rem,7vw,5.5rem)] leading-none font-light">
				Nos vemos en Ramallo
			</h2>

			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				<div class="border-t border-black/20 pt-5">
					<p class="text-[10px] tracking-[0.3em] uppercase text-ink/55">Cuándo</p>
					<p class="mt-3 text-[20px] leading-tight sm:text-[22px]">Domingo 7 de febrero · 19 hs</p>
				</div>
				<div class="border-t border-black/20 pt-5">
					<p class="text-[10px] tracking-[0.3em] uppercase text-ink/55">Dónde</p>
					<p class="mt-3 text-[20px] leading-tight sm:text-[22px]">Salón Catering Tita</p>
				</div>
				<div class="border-t border-black/20 pt-5">
					<p class="text-[10px] tracking-[0.3em] uppercase text-ink/55">Dirección</p>
					<p class="mt-3 text-[20px] leading-tight sm:text-[22px]">
						Camino Dr. Carlos Obligado, Ramallo
					</p>
				</div>
				<div class="border-t border-black/20 pt-5">
					<p class="text-[10px] tracking-[0.3em] uppercase text-ink/55">Vestimenta</p>
					<p class="mt-3 text-[20px] leading-tight sm:text-[22px]">Elegante</p>
				</div>
			</div>

			<a
				href="https://maps.app.goo.gl/JHYhxaz5i2PJ7pb98"
				target="_blank"
				rel="noopener"
				class="mt-10 inline-block border border-black px-8 py-3 text-[11px] tracking-[0.3em] uppercase transition-colors hover:bg-black hover:text-white"
			>
				Abrir en Google Maps
			</a>
		</div>

		<div class="grid gap-4 sm:grid-cols-[0.78fr_1fr]">
			<div class="aspect-[3/4] overflow-hidden rounded-t-full bg-mist">
				<Image
					src={retrato}
					alt="Lucía y Fausto abrazados frente a frente bajo los árboles de un campo"
					class="h-full w-full object-cover object-[50%_52%]"
					widths={[420, 640, 900, 1050]}
					sizes="(min-width: 1024px) 24vw, 100vw"
					quality={80}
					loading="lazy"
				/>
			</div>
			<div class="aspect-[4/5] overflow-hidden rounded-[1.25rem] border border-black/10 bg-white sm:rounded-[1.75rem]">
				<iframe
					title="Mapa con la ubicación del evento: Salón Catering Tita, Ramallo"
					src="https://www.google.com/maps?q=-33.494440,-59.991723&z=15&output=embed"
					class="h-full w-full border-0 grayscale"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</div>
		</div>
	</div>
</section>
