// Hereda el color vía currentColor para usarse en blanco (hero) o negro.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 135 201" fill="none" class={className} aria-hidden="true">
	<path
		d="M67.2112 199.668C104.055 199.668 133.922 155.083 133.922 100.084C133.922 45.0853 104.055 0.5 67.2112 0.5C30.3676 0.5 0.5 45.0853 0.5 100.084C0.5 155.083 30.3676 199.668 67.2112 199.668Z"
		stroke="currentColor"
		stroke-miterlimit="10"></path>
	<text
		x="34"
		y="106"
		font-family="Cormorant Garamond, Didot, Times New Roman, serif"
		font-weight="300"
		font-size="82"
		fill="currentColor">L</text>
	<text
		x="60"
		y="150"
		font-family="Cormorant Garamond, Didot, Times New Roman, serif"
